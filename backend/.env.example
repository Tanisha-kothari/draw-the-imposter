# Database - SQLite for local dev, PostgreSQL for production
# SQLite (local dev - zero config):
DATABASE_URL=sqlite+aiosqlite:///./draw_imposter.db
# PostgreSQL (Supabase production):
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@HOST:5432/postgres

# Secret key for session/auth - use a long random string in production
SECRET_KEY=dev-secret-key-change-in-production

# Allowed CORS origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Supabase (optional - only needed if using Supabase features)
SUPABASE_URL=
SUPABASE_KEY=
